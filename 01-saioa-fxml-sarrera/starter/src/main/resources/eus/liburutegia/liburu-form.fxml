<?xml version="1.0" encoding="UTF-8"?>

<!-- 1. Inportazioak -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<!-- 2. Erro-elementua -->
<GridPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="eus.liburutegia.controller.LiburuFormController"
          hgap="10" vgap="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Izenburua -->
    <Label text="Izenburua:"
           GridPane.rowIndex="0"
           GridPane.columnIndex="0"/>

    <TextField fx:id="izenburuaField"
               GridPane.rowIndex="0"
               GridPane.columnIndex="1"/>

    <!-- Egilea -->
    <Label text="Egilea:"
           GridPane.rowIndex="1"
           GridPane.columnIndex="0"/>

    <TextField fx:id="egileaField"
               GridPane.rowIndex="1"
               GridPane.columnIndex="1"/>

    <!-- Urtea -->
    <Label text="Urtea:"
           GridPane.rowIndex="2"
           GridPane.columnIndex="0"/>

    <TextField fx:id="urteaField"
               GridPane.rowIndex="2"
               GridPane.columnIndex="1"/>

    <!-- Gorde botoia -->
    <Button text="Gorde"
            onAction="#gorde"
            GridPane.rowIndex="3"
            GridPane.columnIndex="1"/>

    <!-- Mezuaren etiketa -->
    <Label fx:id="mezuaLabel"
           GridPane.rowIndex="4"
           GridPane.columnIndex="1"/>

</GridPane>
